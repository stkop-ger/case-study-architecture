{
  "name": "case-study-architecture",
  "version": "1.0.0",
  "description": "Architecture for case study",
  "main": "index.js",
  "repository": "git@github.com:stkop-ger/case-study-architecture.git",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "dev:build": "tsc -w",
    "dev:start": "nodemon ./dist/src/index.js",
    "dev": "concurrently npm:dev:*",
    "build": "rimraf ./dist && tsc",
    "start": "node ./dist/src/index.js",
    "migration:up": "npm run build && node ./node_modules/typeorm/cli.js migration:run -d dist/src/repositories/typeormconfig.js",
    "migration:down": "npm run build && node ./node_modules/typeorm/cli.js migration:revert -d dist/src/repositories/typeormconfig.js",
    "test": "jest -c ./jest.config.json",
    "test:watch": "jest -c ./jest.config.json --watchAll=true"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "@typescript-eslint/parser": "^5.56.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.36.0",
    "eslint-plugin-jest": "^27.2.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.985.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.2",
    "body-parser": "^2.2.2",
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "inversify": "6.0.1",
    "inversify-express-utils": "^6.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
